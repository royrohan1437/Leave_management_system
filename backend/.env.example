PORT=5000
MONGO_URI=mongodb://127.0.0.1:27017/leave_management_system #or your MONGODB URI
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=7d
CLIENT_URL=http://localhost:5173
SEED_USERS=true
# Optional: use when local Node DNS cannot resolve mongodb+srv records.
DNS_SERVERS=8.8.8.8,1.1.1.1
